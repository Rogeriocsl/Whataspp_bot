# Arquivo .gitignore para projetos Node.js

# Dependências
node_modules/

# Logs e arquivos de ambiente
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.development
.env.test
.env.production

# Cache do npm/yarn
.npm
.yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Pastas de IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Arquivos do sistema
.DS_Store
Thumbs.db

# Arquivos do Electron
dist/
release/
*.exe
*.dmg
*.app

# Arquivos específicos do Puppeteer
.local-chromium/

# Arquivos de build
build/
out/

# Arquivos temporários
tmp/
temp/

# Arquivos de configuração local
*.local

# Arquivos de cobertura de testes
coverage/
.nyc_output/

# Arquivos do TypeScript
*.tsbuildinfo

.wwebjs_auth
.wwebjs_cache